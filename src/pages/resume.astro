---
import Triangles from '../layouts/Triangles.astro';

const resumeUrl = '/resume.pdf';
---

<Triangles>
	<div class="resume-window">
		<object class="resume-viewer" data={resumeUrl} type="application/pdf">
			<iframe class="resume-viewer" src={resumeUrl} title="Neel's resume"></iframe>
			<p>
				Your browser cannot display this PDF inline.
				<a href={resumeUrl}>Open the resume PDF.</a>
			</p>
		</object>
	</div>
</Triangles>

<style>
	:global(.page-shell) {
		display: block;
	}

	.resume-window {
		width: min(100% - 50px, 1120px);
		height: calc(100vh - 56px);
		margin: 28px auto;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 8px;
		background: #2b2b2b;
		box-shadow: 0 22px 70px rgba(0, 0, 0, 0.4);
	}

	.resume-viewer {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	p {
		margin: 1rem;
		font-family: system-ui, sans-serif;
		color: #fff;
	}

	a {
		color: #8bd3ff;
	}

	@media (max-width: 700px) {
		.resume-window {
			width: calc(100% - 24px);
			height: calc(100vh - 32px);
			margin: 16px auto;
		}
	}
</style>
