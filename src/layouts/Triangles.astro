---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <meta name="theme-color" content="#191a1b" />
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      <Font cssVariable="--font-orbitron" />
      <Font cssVariable="--font-cascadia-code" />
      <meta name="generator" content={Astro.generator} />
      <title>Neel's Projects</title>
    </head>

    <body>
      <div class="triangle-grid">
        <div class="grid-highlight" aria-hidden="true"></div>
        <div class="page-shell">
          <slot />
        </div>
      </div>
    </body>
</html>

<style>
    html,
    body {
      margin: 0;
      width: 100%;
      min-height: 100%;
      background: #191a1b;
      overflow-x: clip;
    }

    html {
      color-scheme: dark;
      overscroll-behavior: none;
    }

    body {
      position: relative;
    }

    .triangle-grid {
      --grid-tile-width: 12.5vw;
      position: relative;
      isolation: isolate;
      display: flow-root;
      width: 100%;
      min-height: 100vh;
      min-height: 100svh;
      background: #191a1b;
      background-image: url('../assets/svgs/triangle-grid.svg');
      background-size: var(--grid-tile-width) auto;
      background-position: left top;
      overflow: visible;
    }

    .grid-highlight {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: var(--mouse-trail, transparent);
      mask-image: url('../assets/svgs/triangle-grid.svg');
      mask-size: var(--grid-tile-width) auto;
    }

    .page-shell {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    }

    .orbitron {
      font-family: var(--font-orbitron);
      font-weight: 400;
    }

    .cascadia-code {
      font-family: var(--font-cascadia-code);
      font-weight: 400;
    }
</style>

<script>
    const highlight = document.querySelector<HTMLElement>('.grid-highlight');
    const trailPoints: { x: number; y: number }[] = [];
    const maxTrailPoints = 25;
    let pendingFrame = 0;
    let pointerX = 0;
    let pointerY = 0;

    function updateTrail() {
      pendingFrame = 0;
      trailPoints.push({ x: pointerX, y: pointerY });
      if (trailPoints.length > maxTrailPoints) trailPoints.shift();

      const trail = trailPoints.map((point, index) => {
        const age = index / Math.max(trailPoints.length - 1, 1);
        const alpha = (1 - age) * 0.8;
        const radius = 18 + age * 60;
        return `radial-gradient(
          circle at ${point.x}px ${point.y}px,
          rgba(64, 90, 116, ${alpha}) 0,
          rgba(64, 90, 116, ${alpha * 0.25}) ${radius}px,
          transparent ${radius + 30}px
        )`;
      }).join(', ');
      highlight?.style.setProperty('--mouse-trail', trail);
    }

    const alignHighlight = () => {
      if (highlight) highlight.style.maskPosition = `${-window.scrollX}px ${-window.scrollY}px`;
    };
    alignHighlight();
    window.addEventListener('scroll', alignHighlight, { passive: true });
    document.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!pendingFrame) pendingFrame = requestAnimationFrame(updateTrail);
    }, { passive: true });
</script>
